[Unit]
Description=Conntrack zone for private service VM %i
Wants=network-online.target
After=network-online.target pve-firewall.service
Before=pve-guests.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -ec '/usr/sbin/iptables -t raw -C PREROUTING -i fwbr%ii0 -j CT --zone 1 || /usr/sbin/iptables -t raw -I PREROUTING -i fwbr%ii0 -j CT --zone 1'
ExecStop=-/usr/sbin/iptables -t raw -D PREROUTING -i fwbr%ii0 -j CT --zone 1

[Install]
WantedBy=multi-user.target
