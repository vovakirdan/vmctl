# Root-owned 0600. Generate a unique backend secret; never copy it to guest clients.
# Replace the placeholder with the same value as /etc/agentmemory/backend-secret.
CI=1
AGENTMEMORY_DATA_DIR=/srv/agentmemory/state
AGENTMEMORY_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_BACKEND_SECRET
EMBEDDING_PROVIDER=local
AGENTMEMORY_AUTO_COMPRESS=false
AGENTMEMORY_INJECT_CONTEXT=false
GRAPH_EXTRACTION_ENABLED=false
CONSOLIDATION_ENABLED=false
CLAUDE_MEMORY_BRIDGE=false
VIEWER_ALLOWED_ORIGINS=http://127.0.0.2:3113
HF_HOME=/srv/agentmemory/cache/huggingface
TRANSFORMERS_CACHE=/srv/agentmemory/cache/transformers
NODE_OPTIONS="--import=/opt/agentmemory/app/cache.mjs --max-old-space-size=4096"
PATH=/opt/agentmemory/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Preserve migrated graph links; schedule explicit maintenance separately.
AGENTMEMORY_GRAPH_COMPACT_ON_BOOT=false
